{
  "name": "roboeye",
  "private": true,
  "version": "1.2.1",
  "description": "RoboEye — biến camera laptop thành mắt robot, chạy toàn bộ trong trình duyệt",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "security:audit": "node scripts/security-audit.mjs",
    "qa": "npm run typecheck && npm run test:unit && npm run build && npm run security:audit && npm run test:detection-e2e && npm run test:release-e2e",
    "fixtures:prepare": "node scripts/prepare-test-models.mjs",
    "fixtures:verify": "node scripts/prepare-test-models.mjs --verify-only",
    "fixtures:detection-benchmark": "node scripts/prepare-detection-benchmark.mjs",
    "fixtures:detection-benchmark:verify": "node scripts/prepare-detection-benchmark.mjs --verify-only",
    "prebenchmark:detection": "npm run build && npm run fixtures:detection-benchmark -- --stage",
    "benchmark:detection": "tsx tests/detection-benchmark.ts",
    "pretest:detection-e2e": "npm run build",
    "test:detection-e2e": "node tests/detection-e2e.mjs",
    "pretest:detection-models": "npm run build",
    "test:detection-models": "node tests/detection-model-smoke.mjs",
    "pretest:release-e2e": "npm run build",
    "test:release-e2e": "node tests/release-e2e.mjs",
    "presmoke": "npm run fixtures:prepare && npm run build",
    "smoke": "node tests/smoke.mjs",
    "build:offline": "npm run fixtures:prepare && ROBOEYE_OFFLINE=1 npm run build && node scripts/stage-offline-release.mjs && node scripts/verify-release.mjs --offline",
    "release:verify": "npm run build && node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/noto-serif": "^5.2.5",
    "@huggingface/transformers": "^3.8.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.23.8",
    "typescript": "~5.9.2",
    "vite": "^7.0.2"
  }
}
